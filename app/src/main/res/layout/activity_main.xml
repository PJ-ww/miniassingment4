<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".MainActivity">

    <!-- กรอบสีม่วงอ่อน -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/purple_border"
        android:layout_margin="16dp"
        android:orientation="vertical"
        android:padding="16dp"
        tools:ignore="UselessParent">

        <!-- 1. ส่วน Radius -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/redius"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_radius"
                android:textAppearance="@style/TextAppearance.AppCompat.Large"
                android:textSize="26sp" />

            <EditText
                android:id="@+id/input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/hint_radius"
                android:importantForAutofill="no"
                android:inputType="numberDecimal"
                android:textColorHint="#AAAAAA"
                android:textSize="24sp"
                tools:ignore="TooWide" />

        </LinearLayout>

        <!-- 2. ส่วน Circular Area -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/CircularArea"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_area"
                android:textAppearance="@style/TextAppearance.AppCompat.Large"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/Result"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.AppCompat.Large"
                android:textSize="23sp" />

        </LinearLayout>

        <!-- 3. ส่วน Buttons (ปรับเป็น MaterialButton และใส่ cornerRadius) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/calculate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="#876ABA"
                android:text="@string/btn_calculate"
                app:cornerRadius="18dp"
                tools:ignore="TooWide" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/clear"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="#876ABA"
                android:text="@string/btn_clear"
                app:cornerRadius="18dp"
                tools:ignore="TooWide" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>