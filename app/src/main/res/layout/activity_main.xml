<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="100dp"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".MainActivity">

    <!-- กรอบสีม่วงอ่อน (Main Card) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@drawable/purple_border"
        android:orientation="vertical"
        android:padding="16dp"
        tools:ignore="UselessParent">

        <!-- 1. ส่วน Radius -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/redius"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/label_radius"
                android:textAppearance="@style/TextAppearance.AppCompat.Large"
                android:textSize="22sp" />

            <!-- ช่อง Input แก้ไขใส่ minHeight และ ignore TouchTargetSize -->
            <EditText
                android:id="@+id/input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/purple_border"
                android:hint="@string/hint_radius"
                android:importantForAutofill="no"
                android:inputType="numberDecimal"
                android:minHeight="48dp"
                android:padding="10dp"
                android:textColorHint="#AAAAAA"
                android:textSize="20sp"
                tools:ignore="TooWide,VisualLintTextFieldSize,VisualLintTouchTargetSize" />

        </LinearLayout>

        <!-- 2. ส่วน Circular Area -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/CircularArea"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/label_area"
                android:textAppearance="@style/TextAppearance.AppCompat.Large"
                android:textSize="22sp" />

            <!-- ช่อง Output พร้อมกรอบ -->
            <TextView
                android:id="@+id/Result"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/purple_border"
                android:minHeight="48dp"
                android:padding="10dp"
                android:textAppearance="@style/TextAppearance.AppCompat.Large"
                android:textSize="20sp" />

        </LinearLayout>

        <!-- 3. ส่วน Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/calculate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="#673AB7"
                android:text="@string/btn_calculate"
                android:textColor="#FFFFFF"
                app:cornerRadius="20dp"
                tools:ignore="TooWide,VisualLintButtonSize,VisualLintContrast" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/clear"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="#673AB7"
                android:text="@string/btn_clear"
                android:textColor="#FFFFFF"
                app:cornerRadius="20dp"
                tools:ignore="TooWide,VisualLintButtonSize,VisualLintContrast" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>